# =============================================================================
# Auth Server Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Environment variables always take precedence over .env file values.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Display name used in UI, emails, and SMS messages
APP_NAME=My Auth

# The label for user identifiers (e.g., "Acme ID", "My Account")
APP_ID_LABEL=Account ID

# Public-facing base URL (used as OIDC issuer, JWT iss claim, email links)
ISSUER_URL=https://auth.gilos.org

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=5001

# Set to true in production (requires HTTPS)
SECURE_COOKIES=false

# Optional domain for cookies (e.g., ".example.com" for cross-subdomain)
# COOKIE_DOMAIN=

# CORS allowed origins (comma-separated)
CORS_ORIGINS=https://auth.gilos.org

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DB_PATH=database/auth.db

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# 64-char hex string (32 bytes) for AES-256-GCM encryption of TOTP secrets.
# Generate with: openssl rand -hex 32
# ENCRYPTION_KEY=

# Comma-separated IP addresses/CIDRs whose X-Forwarded-For headers are trusted.
# TRUSTED_PROXIES=127.0.0.1

# Bcrypt hashing cost (default 12, range 10-14)
BCRYPT_COST=12

# -----------------------------------------------------------------------------
# Email Provider
# -----------------------------------------------------------------------------
# HTTP API endpoint for sending emails
# EMAIL_API_ENDPOINT=https://api.example.com/send
# EMAIL_API_TOKEN=your-email-api-token

# -----------------------------------------------------------------------------
# SMS Provider (Eskiz — Uzbekistan)
# -----------------------------------------------------------------------------
# ESKIZ_EMAIL=
# ESKIZ_PASSWORD=
# ESKIZ_FROM_NAME=
